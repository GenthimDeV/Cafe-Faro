---
import type { Dictionary } from '../i18n/es';
import type { Locale } from '../i18n';
import { anchors } from '../data/anchors';

interface Props {
  lang: Locale;
  t: Dictionary['how'];
}

const { t, lang } = Astro.props;
const a = anchors[lang];

// Iconos decorativos, uno por paso (mismo orden que t.steps).
const icons = [
  [
    'M12 20h20a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H12a3 3 0 0 1-3-3V23a3 3 0 0 1 3-3z',
    'M14 20l3-10h10l3 10',
    'M22 10V6M28 6h-6',
  ],
  ['M18 6h8M22 6v6', 'M22 18v6l4 3'],
  ['M8 16l14-7 14 7v14l-14 7-14-7z', 'M8 16l14 7 14-7M22 23v14'],
];
---

<section
  id={a.how}
  class="relative overflow-hidden bg-ink text-salt"
>
  <div
    aria-hidden="true"
    class="absolute -left-[200px] -top-[160px] size-[520px] rounded-full border border-line-dark"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute -left-[120px] -top-[80px] size-[360px] rounded-full border border-line-dark"
  >
  </div>

  <div
    class="relative mx-auto flex max-w-[1240px] flex-col gap-16 px-6 py-[120px] max-md:py-20"
  >
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="flex max-w-[640px] flex-col gap-[18px]">
        <p class="font-mono text-[13px] uppercase tracking-[0.08em] text-beam">
          {t.eyebrow}
        </p>
        <h2
          class="text-[clamp(36px,4.6vw,60px)] font-extrabold leading-none tracking-[-0.035em]"
        >
          {t.titleBefore}<span class="font-normal italic">{t.titleAccent}</span>
        </h2>
      </div>
      <p class="max-w-[360px] text-[17px] leading-[1.6] text-muted-dark">
        {t.intro}
      </p>
    </div>

    <ol
      class="grid grid-cols-[repeat(auto-fit,minmax(min(280px,100%),1fr))] gap-5"
    >
      {
        t.steps.map((step, i) => (
          <li class="card-lift reveal flex flex-col gap-[18px] rounded-3xl border border-line-dark bg-night p-[34px] max-md:p-6">
            <div class="flex items-center justify-between">
              <span class="font-mono text-sm text-beam">
                {t.stepLabel} {String(i + 1).padStart(2, '0')}
              </span>
              <svg
                width="44"
                height="44"
                viewBox="0 0 44 44"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {icons[i].map((d) => (
                  <path d={d} />
                ))}
                {i === 0 && <circle cx="22" cy="28" r="3" />}
                {i === 1 && <circle cx="22" cy="24" r="12" />}
              </svg>
            </div>
            <h3 class="text-[26px] font-extrabold tracking-[-0.02em]">
              {step.title}
            </h3>
            <p class="text-base leading-[1.6] text-muted-dark">{step.text}</p>

            {i === 0 && (
              <ul class="pills flex flex-wrap gap-1.5 text-xs font-semibold">
                {t.grinds.map((g, n) => (
                  <li
                    class="pill rounded-full border border-line-dark px-2.5 py-1.5 text-muted-dark"
                    style={`--pill-delay: ${n * 2}s`}
                  >
                    {g}
                  </li>
                ))}
              </ul>
            )}

            {i === 1 && (
              <div class="flex flex-col gap-1.5">
                <div
                  aria-hidden="true"
                  class="flex justify-between font-mono text-[11px] text-muted-dark"
                >
                  {t.roastStages.map((s) => (
                    <span>{s}</span>
                  ))}
                </div>
                <div
                  role="img"
                  aria-label={t.roastLabel}
                  class="h-1.5 overflow-hidden rounded-[3px] bg-deep"
                >
                  <div class="roast-fill h-1.5 w-[72%] rounded-[3px] bg-beam" />
                </div>
              </div>
            )}

            {i === 2 && (
              <p class="flex items-center gap-2.5 text-[13px] text-muted-dark">
                <span
                  aria-hidden="true"
                  class="size-2 shrink-0 rounded-full bg-lamp"
                />
                {t.transit}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import LighthouseScene from './LighthouseScene.astro';
import type { Dictionary } from '../i18n/es';
import type { Locale } from '../i18n';
import { anchors } from '../data/anchors';

interface Props {
  lang: Locale;
  t: Dictionary['hero'];
}

const { t, lang } = Astro.props;
const a = anchors[lang];
---

<section class="relative overflow-hidden bg-night text-salt">
  <div aria-hidden="true" class="star-dust"></div>
  <div
    class="relative mx-auto flex max-w-[1240px] flex-wrap items-end gap-10 px-6 pt-12 lg:flex-nowrap"
  >
    <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-[30px] pb-12 lg:pb-24">
      <p
        class="inline-flex items-center gap-2.5 font-mono text-[13px] uppercase tracking-[0.08em] text-beam"
      >
        <span aria-hidden="true" class="size-2 rounded-full bg-beam"></span>
        {t.batch}
      </p>
      <h1
        class="text-[clamp(48px,6.6vw,92px)] font-extrabold leading-[0.94] tracking-[-0.04em]"
      >
        {t.titleBefore}<span class="text-beam">{t.titleAccent}</span
        >{t.titleAfter}
      </h1>
      <p class="max-w-[500px] text-[19px] leading-[1.6] text-muted-dark">
        {t.text}
      </p>
      <div class="flex flex-wrap items-center gap-x-[22px] gap-y-4">
        <a
          href={`#${a.plan}`}
          data-subscribe
          class="btn-cta inline-flex min-h-[58px] items-center gap-3 rounded-full bg-beam px-[30px] py-[19px] text-[17px] font-bold text-night no-underline"
        >
          {t.cta}
          <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
          >
            <path d="M3 9h12M10 4l5 5-5 5"></path>
          </svg>
        </a>
        <a
          href={`#${a.how}`}
          class="link-anim inline-flex min-h-11 items-center border-b border-[#4E6578] text-base font-medium text-salt no-underline"
        >
          {t.secondary}
        </a>
      </div>
    </div>

    <LighthouseScene />
  </div>
</section>

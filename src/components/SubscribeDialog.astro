---
import type { Dictionary } from '../i18n/es';

interface Props {
  t: Dictionary['subscribe'];
  coffees: string[];
  grinds: string[];
}

const { t, coffees, grinds } = Astro.props;
const total = 3;
const progress = (n: number) => t.progress.replace('{n}', String(n)).replace('{total}', String(total));
const d = t.delivery;
const fields = [
  { name: 'name', label: d.name, type: 'text', autocomplete: 'name' },
  { name: 'email', label: d.email, type: 'email', autocomplete: 'email' },
  { name: 'address', label: d.address, type: 'text', autocomplete: 'street-address' },
  { name: 'postal', label: d.postal, type: 'text', autocomplete: 'postal-code' },
  { name: 'city', label: d.city, type: 'text', autocomplete: 'address-level2' },
] as const;
const btn =
  'inline-flex min-h-[52px] items-center justify-center rounded-full px-7 text-[16px] font-bold';
---

<dialog
  id="subscribe-dialog"
  class="subscribe-dialog"
  aria-label={t.title}
  data-progress={t.progress}
  data-total={total}
  data-msg-required={d.required}
  data-msg-email={d.emailInvalid}
  data-msg-postal={d.postalInvalid}
>
  <div class="subscribe-body">
    <form method="dialog" class="subscribe-close-row">
      <button type="submit" class="subscribe-x" aria-label={t.closeLabel}>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </button>
    </form>

    <p id="subscribe-progress" class="font-mono text-[14px] text-beam">{progress(1)}</p>

    <form id="subscribe-form" class="subscribe-steps" novalidate>
      <section class="subscribe-step" data-step="1">
        <h2 class="subscribe-step-title" tabindex="-1">{t.steps.coffee}</h2>
        <fieldset class="subscribe-fieldset">
          <legend>{t.coffeeLegend}</legend>
          {
            coffees.map((name) => (
              <label class="subscribe-choice">
                <input type="radio" name="coffee" value={name} />
                <span>{name}</span>
              </label>
            ))
          }
        </fieldset>
        <fieldset class="subscribe-fieldset subscribe-fieldset-pills">
          <legend>{t.grindLegend}</legend>
          {
            grinds.map((name) => (
              <label class="subscribe-choice">
                <input type="radio" name="grind" value={name} />
                <span>{name}</span>
              </label>
            ))
          }
        </fieldset>
        <p id="subscribe-error" class="subscribe-error" role="alert" hidden>{t.choiceError}</p>
        <p class="font-mono text-[14px] text-salt">{t.priceNote}</p>
        <p class="text-[14px] text-muted-dark">{t.demo}</p>
      </section>

      <section class="subscribe-step" data-step="2" hidden>
        <h2 class="subscribe-step-title" tabindex="-1">{t.steps.delivery}</h2>
        {
          fields.map((f) => (
            <div class="subscribe-field">
              <label for={`sub-${f.name}`}>{f.label}</label>
              <input
                id={`sub-${f.name}`}
                name={f.name}
                type={f.type}
                autocomplete={f.autocomplete}
                maxlength={f.name === 'postal' ? 10 : 120}
                required
                data-field
                aria-describedby={`sub-${f.name}-error`}
              />
              <p id={`sub-${f.name}-error`} class="subscribe-error" hidden />
            </div>
          ))
        }
      </section>

      <section class="subscribe-step" data-step="3" hidden>
        <h2 class="subscribe-step-title" tabindex="-1">{t.steps.summary}</h2>
        <p class="text-[16px] text-muted-dark">{t.placeholder}</p>
      </section>

      <div class="subscribe-nav">
        <button type="button" id="subscribe-back" class={`${btn} border border-line-dark text-salt`} hidden>
          {t.back}
        </button>
        <button type="button" id="subscribe-next" class={`btn-cta ${btn} bg-beam text-night`}>
          {t.next}
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  // Los botones «Suscribirme» ([data-subscribe]) abren el diálogo modal. Sin JS (o sin soporte
  // de <dialog>) siguen siendo enlaces al plan. El foco queda atrapado y Esc cierra de forma
  // nativa; al cerrar, el navegador devuelve el foco al botón que lo abrió.
  const dialog = document.getElementById('subscribe-dialog') as HTMLDialogElement | null;

  if (dialog && typeof dialog.showModal === 'function') {
    document.addEventListener(
      'click',
      (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const trigger = (e.target as Element).closest('[data-subscribe]');
        if (!trigger) return;
        e.preventDefault();
        if (!dialog.open) dialog.showModal();
      },
      true,
    );

    // Clic en el fondo: el diálogo no tiene padding propio, así que un clic cuyo destino es el
    // propio <dialog> cae fuera del contenido.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Esc cierra siempre. El cierre nativo (evento `cancel`) no es fiable en todos los casos
    // (p. ej. Chrome lo ignora si no hubo interacción tras abrir), así que se gestiona a mano.
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      e.preventDefault();
      dialog.close();
    });

    // Flujo de pasos: todos los pasos están en el HTML y se alternan con `hidden`. El estado
    // (café, molienda, paso actual) vive solo en el DOM, en memoria.
    const total = Number(dialog.dataset.total);
    const progressTpl = dialog.dataset.progress ?? '';
    const form = dialog.querySelector<HTMLFormElement>('#subscribe-form')!;
    const steps = Array.from(dialog.querySelectorAll<HTMLElement>('.subscribe-step'));
    const progress = dialog.querySelector<HTMLElement>('#subscribe-progress')!;
    const back = dialog.querySelector<HTMLButtonElement>('#subscribe-back')!;
    const next = dialog.querySelector<HTMLButtonElement>('#subscribe-next')!;
    const error = dialog.querySelector<HTMLElement>('#subscribe-error')!;
    let current = 1;

    const showStep = (n: number) => {
      current = n;
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
      progress.textContent = progressTpl.replace('{n}', String(n)).replace('{total}', String(total));
      back.hidden = n === 1;
      next.hidden = n === total;
      error.hidden = true;
      steps[n - 1].querySelector<HTMLElement>('.subscribe-step-title')?.focus();
    };

    const picked = (name: string) => !!form.querySelector(`input[name="${name}"]:checked`);

    // Paso 2: validación propia (el formulario lleva `novalidate`). Mensaje bajo el campo con
    // aria-invalid + aria-describedby; solo se valida un campo tras tocarlo o al pulsar «Siguiente».
    const msgs = {
      required: dialog.dataset.msgRequired ?? '',
      email: dialog.dataset.msgEmail ?? '',
      postal: dialog.dataset.msgPostal ?? '',
    };
    const fieldEls = Array.from(form.querySelectorAll<HTMLInputElement>('[data-field]'));

    const messageFor = (input: HTMLInputElement) => {
      const v = input.value.trim();
      if (!v) return msgs.required;
      if (input.name === 'email' && !/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(v)) return msgs.email;
      if (input.name === 'postal' && !/^[A-Za-z0-9][A-Za-z0-9 -]{2,8}[A-Za-z0-9]$/.test(v)) return msgs.postal;
      return '';
    };
    const validate = (input: HTMLInputElement) => {
      const msg = messageFor(input);
      const out = form.querySelector<HTMLElement>(`#${input.id}-error`)!;
      out.textContent = msg;
      out.hidden = !msg;
      if (msg) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      return !msg;
    };
    fieldEls.forEach((input) => {
      input.addEventListener('blur', () => {
        input.dataset.touched = 'true';
        validate(input);
      });
      input.addEventListener('input', () => {
        if (input.dataset.touched) validate(input);
      });
    });

    next.addEventListener('click', () => {
      if (current === 1 && !(picked('coffee') && picked('grind'))) {
        error.hidden = false;
        form.querySelector<HTMLInputElement>(`input[name="${picked('coffee') ? 'grind' : 'coffee'}"]`)?.focus();
        return;
      }
      if (current === 2) {
        const invalid = fieldEls.filter((input) => {
          input.dataset.touched = 'true';
          return !validate(input);
        });
        if (invalid.length) {
          invalid[0].focus();
          return;
        }
      }
      if (current < total) showStep(current + 1);
    });
    back.addEventListener('click', () => {
      if (current > 1) showStep(current - 1);
    });
    form.addEventListener('change', () => {
      if (picked('coffee') && picked('grind')) error.hidden = true;
    });
    // Enter dentro del formulario no debe enviarlo ni recargar la página
    form.addEventListener('submit', (e) => e.preventDefault());
  }
</script>

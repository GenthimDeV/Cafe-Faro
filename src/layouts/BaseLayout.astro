---
import '../styles/global.css';
import { anchors } from '../data/anchors';
import { site } from '../data/site';
import { defaultLocale, locales, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  ogImageAlt: string;
  skipLabel: string;
}

const { lang, title, description, ogImageAlt, skipLabel } = Astro.props;

// Con `site` definido (tarea 6.1) las URLs hreflang/canonical serán absolutas;
// mientras tanto son relativas para no filtrar localhost al build.
const abs = (locale: Locale) =>
  Astro.site ? new URL(`/${locale}/`, Astro.site).href : `/${locale}/`;
const ogImage = Astro.site ? new URL(site.ogImage, Astro.site).href : site.ogImage;
const ogLocale = { es: 'es_ES', en: 'en_US' } as const;
const otherLocales = locales.filter((l) => l !== lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(lang)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(defaultLocale)} />
    <meta name="theme-color" content="#0b1c2c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Café Faro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <a
      href={`#${anchors[lang].content}`}
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-beam focus:px-4 focus:py-2 focus:font-semibold focus:text-night"
    >
      {skipLabel}
    </a>
    <slot name="header" />
    <main id={anchors[lang].content}>
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // URL limpia: los enlaces internos (#sección) hacen scroll suave y la URL queda sin `#`.
      // Sin JS siguen funcionando como anclas normales. La sección actual se publica en
      // `document.documentElement.dataset.section` (y el evento `section-change`) para que
      // el selector de idioma pueda conservarla.
      const root = document.documentElement;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      const setSection = (id: string) => {
        if ((root.dataset.section ?? '') === id) return;
        root.dataset.section = id;
        document.dispatchEvent(new CustomEvent('section-change'));
      };

      // Sección visible al hacer scroll a mano: franja fina al ~35 % del viewport; la sección
      // que la cruza es la actual (las que no tienen id, como el hero, la dejan vacía).
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) if (en.isIntersecting) setSection(en.target.id);
          },
          { rootMargin: '-35% 0px -64% 0px' },
        );
        document.querySelectorAll('main section').forEach((s) => io.observe(s));
      }
      const cleanUrl = () => history.replaceState(history.state, '', location.pathname + location.search);
      const targetOf = (hash: string) => {
        const id = decodeURIComponent(hash.slice(1));
        return id ? document.getElementById(id) : null;
      };

      // Llegada con ancla (p. ej. desde el selector de idioma): se hace el scroll a mano y
      // después se limpia el `#`. Limpiarlo antes de que el navegador lo procese lo perdía
      // y la página se quedaba arriba.
      const arrive = () => {
        const target = location.hash ? targetOf(location.hash) : null;
        if (!target) return;
        target.scrollIntoView({ behavior: 'auto', block: 'start' });
        setSection(target.id);
        cleanUrl();
      };
      if (document.readyState === 'complete') arrive();
      else window.addEventListener('load', arrive, { once: true });

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link) return;
        const target = targetOf(link.getAttribute('href')!);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
        if (!target.hasAttribute('tabindex') && !/^(A|BUTTON|INPUT|SELECT|TEXTAREA|SUMMARY)$/.test(target.tagName)) {
          target.setAttribute('tabindex', '-1');
        }
        target.focus({ preventScroll: true });
        setSection(target.id);
        cleanUrl();
      });
    </script>
  </body>
</html>
